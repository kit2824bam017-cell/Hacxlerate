DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/v2holoroid"
AUTH_SECRET="learnai-dev-secret-change-me"
APP_DEBUG=true
NEXT_PUBLIC_APP_NAME=LearnAI

OPENAI_API_KEY=

# Google Gemini (homework photo hints — vision)
GEMINI_API_KEY=
# Optional; default gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# Microsoft Foundry / Azure OpenAI model router (chat)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=LearnAI
# Use a date like 2024-10-21 for classic deployments. Leave unset for /openai/v1.
AZURE_OPENAI_API_VERSION=

# Azure Speech to Text (teacher onboarding + student voice)
AZURE_SPEECH_TO_TEXT_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_SPEECH_TO_TEXT_API_KEY=

# Azure Text to Speech (student audio output — multilingual Neural voices)
AZURE_TEXT_TO_SPEECH_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_TEXT_TO_SPEECH_API_KEY=

ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
D_ID_API_KEY=
CLOUDINARY_URL=

# Optional SMTP. If unset, OTPs are logged to the server console and returned in debug JSON.
MAIL_FROM_ADDRESS=hello@learnai.local
MAIL_FROM_NAME=LearnAI
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
